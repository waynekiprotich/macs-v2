GEMINI_API_KEY=your_gemini_api_key
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=True
MACS_MODE=PAPER
MACS_INTERVAL_MINUTES=5
MACS_MAX_CONSECUTIVE_LOSSES=3
MACS_MIN_CONFIDENCE_SCORE=0.8
# Local SQLite. For Supabase paste the Session pooler URI (Project Settings -> Database;
# user postgres.<project-ref>, host aws-0-<region>.pooler.supabase.com, port 5432),
# after running `alembic upgrade head` against it.
DATABASE_URL=sqlite:///macs.db
DISCORD_WEBHOOK_URL=
# Deriv credentials (required by the live worker)
DERIV_API_TOKEN=your_deriv_api_token
DERIV_APP_ID=your_deriv_app_id
# scripts/preflight.py refuses SQLite unless this is 1. Local development only:
# never set it in production.
MACS_ALLOW_SQLITE=1
