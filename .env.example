GEMINI_API_KEY=your_gemini_api_key
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=True
MACS_MODE=PAPER
MACS_INTERVAL_MINUTES=5
MACS_MAX_CONSECUTIVE_LOSSES=3
MACS_MIN_CONFIDENCE_SCORE=0.8
# Local SQLite. For Supabase paste the Session pooler URI (Project Settings -> Database;
# user postgres.<project-ref>, host aws-0-<region>.pooler.supabase.com, port 5432),
# after running `alembic upgrade head` against it.
DATABASE_URL=sqlite:///macs.db
DISCORD_WEBHOOK_URL=
# Deriv credentials (required by the live worker)
DERIV_API_TOKEN=your_deriv_api_token
DERIV_APP_ID=your_deriv_app_id
# scripts/preflight.py refuses SQLite unless this is 1. Local development only:
# never set it in production.
MACS_ALLOW_SQLITE=1

# Reviewed demo experiment. Leave execution off while collecting observations.
MACS_EXECUTION_ENABLED=false
MACS_EXPERIMENT_ID=otc-buy-7of8-v1
# JSON, with one independently configured rule per symbol. Unknown symbols only observe.
MACS_MARKET_RULES='{"OTC_DJI":{"enabled":true,"directions":["BUY"],"min_conditions":7,"min_payout":0.8,"duration_minutes":15,"hourly_confirmation":false,"cooldown_bars":1},"frxXAUUSD":{"enabled":false}}'
MACS_RISK_PER_TRADE=0.0025
MACS_MAX_STAKE=25
MACS_MIN_STAKE=0.35
MACS_MAX_OPEN_TRADES=1
MACS_MAX_OPEN_EXPOSURE=0.01
MACS_DAILY_LOSS_FRACTION=0.02
MACS_MAX_DAILY_LOSS=500
MACS_COOLDOWN_HOURS=4
